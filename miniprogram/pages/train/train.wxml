<!-- ==================== 列表：该复习的题 ==================== -->
<view class="page page-tab" wx:if="{{mode === 'list'}}">

  <view class="sec-title">按记忆曲线到期 · 点一道开始练</view>

  <block wx:if="{{dueList.length}}">
    <view class="card card-tight item" wx:for="{{dueList}}" wx:key="id" bindtap="startFromList" data-id="{{item.id}}">
      <view class="row between">
        <view class="row gap8">
          <text class="item-no">Q{{item.no}}</text>
          <view class="score-badge sc-{{item.level}}">{{item.score}}<text class="f22">/{{item.fullScore}}</text></view>
          <view class="tag {{item.statusCls}}">{{item.statusText}}</view>
        </view>
        <text class="t3 f22 nowrap">{{item.dueText}}</text>
      </view>
      <view class="item-text clamp2">{{item.text}}</view>
      <view class="row wrap mt8">
        <view class="tag tag-brand" wx:for="{{item.kpNames}}" wx:for-item="k" wx:key="*this">{{k}}</view>
      </view>
    </view>
  </block>

  <view class="card empty" wx:else>
    <view class="empty-ico">🎯</view>
    <view class="empty-txt">今天没有到期的复习</view>
    <view class="empty-sub">订正完的错题会自动排进复习计划</view>
    <view class="btn btn-ghost mt24" style="width:300rpx;margin:24rpx auto 0" bindtap="goList">去错题本</view>
  </view>

</view>

<!-- ==================== 答题 ==================== -->
<view class="page quiz-page" wx:elif="{{mode === 'quiz'}}">

  <view class="prog">
    <view class="row between mb8">
      <text class="f24 t2">Q{{target.no}} · 第 {{idx + 1}} / {{sessions.length}} 题</text>
      <text class="f24 t3" bindtap="quit">退出</text>
    </view>
    <view class="bar">
      <view class="bar-in" style="width:{{(idx + 1) / sessions.length * 100}}%"></view>
    </view>
  </view>

  <!-- 题干 -->
  <view class="blk">
    <view class="q-kind">
      {{cur.kind === 'judge' ? '判断题' : cur.kind === 'choice' ? '选择题' : cur.kind === 'fill' ? '填空题' : '排序题'}}
    </view>
    <view class="qtext">{{cur.q}}</view>
  </view>

  <!-- 判断题 -->
  <view class="opts" wx:if="{{cur.kind === 'judge'}}">
    <view class="opt opt-j" bindtap="answerJudge" data-v="1">
      <text class="opt-mark ok">√</text>
      <text class="opt-txt">这句话是对的</text>
    </view>
    <view class="opt opt-j" bindtap="answerJudge" data-v="0">
      <text class="opt-mark bad">×</text>
      <text class="opt-txt">这句话是错的</text>
    </view>
  </view>

  <!-- 选择题 -->
  <view class="opts" wx:elif="{{cur.kind === 'choice'}}">
    <view
      class="opt"
      wx:for="{{cur.options}}"
      wx:key="*this"
      bindtap="answerChoice"
      data-i="{{index}}"
    >
      <text class="opt-key">{{optKeys[index]}}</text>
      <text class="opt-txt">{{item}}</text>
    </view>
  </view>

  <!-- 填空题 -->
  <view class="blk" wx:elif="{{cur.kind === 'fill'}}">
    <input
      class="fill-in"
      value="{{fillVal}}"
      bindinput="onFillInput"
      placeholder="写下你的答案，例如 x₀ > s − ε"
      placeholder-class="ta-ph"
      confirm-type="done"
      bindconfirm="answerFill"
    />
    <view class="btn btn-primary btn-block mt16" wx:if="{{!judged}}" bindtap="answerFill">提交答案</view>
    <view class="t3 f22 mt12">打不出特殊符号没关系，用 e 代替 ε、用 0 代替下标 0 也能判对。</view>
  </view>

  <!-- 排序题 -->
  <view class="order-wrap" wx:elif="{{cur.kind === 'order'}}">
    <view class="order-tip">按正确顺序依次点击下面的步骤（再点一次可取消）</view>
    <view
      class="order-item {{orderNo[t.i] ? 'order-on' : ''}}"
      wx:for="{{cur.tokens}}"
      wx:for-item="t"
      wx:key="i"
      bindtap="toggleOrder"
      data-i="{{t.i}}"
    >
      <text class="order-no">{{orderNo[t.i] || ''}}</text>
      <text class="order-txt">{{t.text}}</text>
    </view>
    <view class="btn btn-primary btn-block mt16" wx:if="{{!judged}}" bindtap="submitOrder">提交顺序</view>
  </view>

  <!-- 判分结果 -->
  <view class="blk res {{judgeResult.correct ? 'res-ok' : 'res-bad'}}" wx:if="{{judged}}">
    <view class="res-title">{{judgeResult.correct ? '✓ 答对了' : '✗ 答错了'}}</view>
    <view class="res-expect" wx:if="{{!judgeResult.correct && judgeResult.expectText}}">
      正确答案：{{judgeResult.expectText}}
    </view>
    <view class="res-exp" wx:if="{{cur.explain}}">{{cur.explain}}</view>
    <view class="btn btn-primary btn-block mt16" bindtap="next">
      {{idx + 1 >= sessions.length ? '看本次结果' : '下一题'}}
    </view>
  </view>

</view>

<!-- ==================== 结果 ==================== -->
<view class="page" wx:elif="{{mode === 'result'}}">

  <view class="res-head">
    <view class="res-score {{correctCount >= passLine ? 'ok' : 'bad'}}">{{correctCount}}<text class="res-total">/{{sessions.length}}</text></view>
    <view class="res-lbl">{{correctCount >= passLine ? '通过 · 记忆间隔会拉长' : '正确率不足 ' + (passLine / sessions.length * 100) + '% · 明天再排一次'}}</view>
    <view class="res-kp">
      <view class="tag tag-brand" wx:for="{{target.kpNames}}" wx:for-item="k" wx:key="*this">{{k}}</view>
    </view>
  </view>

  <view class="card card-tight" wx:for="{{results}}" wx:key="id">
    <view class="row between">
      <text class="f26 t2">第 {{item.no}} 题 · {{item.kind === 'judge' ? '判断' : item.kind === 'choice' ? '选择' : item.kind === 'fill' ? '填空' : '排序'}}</text>
      <view class="tag {{item.correct ? 'tag-ok' : 'tag-bad'}}">{{item.correct ? '✓ 对' : '✗ 错'}}</view>
    </view>
    <view class="res-q clamp2">{{item.q}}</view>
  </view>

  <view class="btn btn-primary btn-block" bindtap="finish">完成本次训练</view>
  <view class="btn btn-line btn-block mt16" bindtap="goCorrect">回去再看一遍订正</view>

</view>
